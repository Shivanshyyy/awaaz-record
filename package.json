{
  "name": "awaaz-record",
  "private": true,
  "version": "0.1.0",
  "description": "Offline visit notes for clinic health workers: speak, check, confirm, hand the patient a slip.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node scripts/copy-ort.mjs && node scripts/build-hindi-clips.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ort.mjs && node scripts/build-hindi-clips.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:shots": "SCREENSHOTS=1 playwright test",
    "fetch-models": "node scripts/fetch-models.mjs",
    "tts-audio": "node scripts/make-tts-audio.mjs",
    "eval": "node scripts/eval.mjs",
    "icons": "node scripts/make-icons.mjs",
    "hindi-clips": "node scripts/build-hindi-clips.mjs",
    "fetch-primock": "node scripts/fetch-primock57.mjs",
    "check-live": "node scripts/check-live.mjs",
    "make-hindi-clips": "node scripts/make-hindi-clips.mjs",
    "fetch-accent": "node scripts/fetch-accent-archive.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "idb": "^8.0.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "ffmpeg-static": "^5.3.0",
    "jsqr": "^1.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "wavefile": "^11.0.0",
    "workbox-window": "^7.4.0"
  }
}
